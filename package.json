{
  "name": "hw-05",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hw/web",
    "dev:api": "turbo run dev --filter=@hw/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@hw/web...",
    "build:api": "turbo run build --filter=@hw/api...",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@hw/web",
    "test:api": "turbo run test --filter=@hw/api",
    "start": "turbo run start",
    "start:web": "npm run start --workspace=@hw/web",
    "start:api": "npm run start --workspace=@hw/api"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  }
}
